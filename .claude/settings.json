{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe bridge.py status*)",
      "Bash(.venv/Scripts/python.exe bridge.py pending*)",
      "Bash(.venv/Scripts/python.exe bridge.py show*)",
      "PowerShell(.venv\\Scripts\\python.exe bridge.py status*)",
      "PowerShell(.venv\\Scripts\\python.exe bridge.py pending*)",
      "PowerShell(.venv\\Scripts\\python.exe bridge.py show*)"
    ],
    "deny": [
      "Bash(*owner_console*)",
      "PowerShell(*owner_console*)",
      "Edit(config/**)", "Write(config/**)",
      "Edit(projects/**)", "Write(projects/**)",
      "Edit(runtime/**)", "Write(runtime/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv\\Scripts\\python.exe hooks\\pending.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
