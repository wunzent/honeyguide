# Python environment
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets (never commit)
.env
.env.*
*.key
*.pem
secrets/
owner-keys/

# Task workspaces: agent records, checkpoints, worker output (local, readable, not committed)
work/

# Local runtime and logs
runtime/
projects/*/
*.log
logs/
worktrees/

# Leftovers from the retired approval mechanism (owner key material stays local)
config/owner.pub*
config/*.sig
config/manifest.json
